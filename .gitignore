# TypeScript compiler artifacts that a failed composite build can emit next to
# their sources (tsc's error-recovery emit path). Upstream builds stay clean,
# so these never belong in the tree.
packages/*/*/src/**/*.js
packages/*/*/src/**/*.js.map
packages/*/*/src/**/*.d.ts
packages/*/*/src/**/*.d.ts.map
